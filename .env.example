APP_NAME="SIMLOG RS Non-Medis"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=simlog_rs
DB_USERNAME=simlog_user
DB_PASSWORD=simlog_pass

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=simlog_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@simlogrs.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Konfigurasi operasional SIMLOG (config/simlog.php). Hapus tanda # untuk mengganti default.
# SIMLOG_API_THROTTLE_MAX_ATTEMPTS=60
# SIMLOG_API_THROTTLE_DECAY_MINUTES=1
# SIMLOG_AUTH_MAX_LOGIN_ATTEMPTS=5
# SIMLOG_CACHE_DROPDOWN_TTL=60
# SIMLOG_UPLOAD_MAX_KB=10240
# SIMLOG_UPLOAD_IMAGE_MAX_DIMENSION=1600
# SIMLOG_UPLOAD_IMAGE_QUALITY=80

# Push notifikasi FCM (docs/NOTIFICATION_CONTRACT.md). Berkas Service Account JANGAN di-commit.
FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json
FIREBASE_PROJECT_ID=simlog-rs
